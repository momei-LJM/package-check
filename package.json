{
  "name": "package-check",
  "displayName": "Package Check",
  "description": "Check package.json dependencies for updates",
  "version": "0.1.1",
  "icon": "public/icon.png",
  "publisher": "momei-package-check",
  "engines": {
    "vscode": "^1.75.0"
  },
  "id": "momei-package-check",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:yaml"
  ],
  "main": "./dist/index.cjs",
  "contributes": {
    "commands": [
      {
        "command": "package-check.checkUpdates",
        "title": "Package Check: Check for Updates"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momei-LJM/package-check.git"
  },
  "bugs": {
    "url": "https://github.com/momei-LJM/package-check/issues"
  },
  "homepage": "https://github.com/momei-LJM/package-check#readme",
  "license": "MIT",
  "author": "momei",
  "files": [
    "dist/**",
    "package.json",
    "README.md",
    "public/icon.png",
    "public/example1.png",
    "public/example2.png",
    "public/example3.png"
  ],
  "keywords": [
    "vscode",
    "extension",
    "package",
    "npm",
    "pnpm",
    "dependencies"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "pack": "vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.0",
    "@types/vscode": "^1.75.0",
    "tsdown": "latest",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "fast-npm-meta": "^1.0.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.5.0",
    "yaml": "^2.8.2"
  }
}